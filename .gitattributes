# Keep active source and documentation line endings normalized in commits.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cff text eol=lf

# Preserve archived historical evidence byte-for-byte in Git. This rule must
# follow the general file-type rules because the last matching attribute wins.
research_archive/** -text

# These fixtures are verified from their exact on-disk bytes.
tests/fixtures/data/*.csv -text

